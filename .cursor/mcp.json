{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "ai360-bff": {
      "command": "node",
      "args": ["mcp/ai360-bff/dist/index.js"],
      "env": {
        "AI360_BFF_URL": "http://localhost:3000"
      }
    },
    "ai360-rules": {
      "command": "node",
      "args": ["mcp/ai360-rules/dist/index.js"]
    }
  }
}
